{
  "name": "perchlight",
  "version": "0.1.0",
  "private": true,
  "description": "A free desktop app for your Cloudflare data: browse and edit Workers KV and D1, build your own screens without code, and run a perchlight-list mailing list.",
  "license": "MIT",
  "author": "Perchlight contributors",
  "homepage": "https://github.com/matpitts13/perchlight",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "smoke": "node scripts/start.js --smoke",
    "test": "vitest run",
    "icon": "node scripts/build-icon.cjs",
    "dist": "electron-builder --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "dev.perchlight.app",
    "productName": "Perchlight",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "schema/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "matpitts13",
      "repo": "perchlight",
      "publishAutoUpdate": false
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Perchlight",
      "artifactName": "Perchlight-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "artifactName": "Perchlight-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Development",
      "artifactName": "Perchlight-${version}.${ext}"
    }
  }
}
